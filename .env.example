# LLM: any OpenAI-compatible Chat Completions endpoint. Default is DeepSeek V3.2 on Amazon Bedrock (Mantle).
LLM_BASE_URL=https://bedrock-mantle.us-west-2.api.aws/v1
LLM_API_KEY=            # Bedrock API key
LLM_MODEL=deepseek.v3.2
LLM_MAX_TOKENS=300
# Offline alternative: ./run.sh --local  (serves Gemma 3 4B on this Mac via mlx_lm.server)

TTS_VOICE=Harper        # any English Phonon catalog voice (pick live in the UI)
TURN_CHECK_MS=200       # silence before Smart Turn is asked whether you're done
TURN_THRESHOLD=0.5      # Smart Turn 'done' probability; higher = waits longer
END_SILENCE_MS=900      # longest pause tolerated before the turn is forced to end
BARGE_IN_MS=250         # how long you must talk over Ava to interrupt her
VAD_THRESHOLD=0.5
PORT=8000
